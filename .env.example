# Active provider. Use mock while the framework is still being finalized.
LLM_PROVIDER=mock

# OpenAI/GPT standby config. Uncomment when switching back to GPT later.
# AI_LITERACY_OPENAI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Xunfei MaaS / OpenAI-compatible config.
# Set LLM_PROVIDER=xfyun and fill XFYUN_MAAS_API_KEY to use it.
# XFYUN_MAAS_API_KEY=
# XFYUN_MAAS_MODEL=Qwen3.6-35B-A3B
# XFYUN_MAAS_BASE_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2

AI_LITERACY_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

AI_LITERACY_KIMI_API_KEY=
KIMI_API_KEY=
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_BASE_URL=https://api.moonshot.cn/v1
# The optional AI reviewer currently uses the same Kimi config.

# Textbook RAG
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
# Leave RAG_DATABASE_PATH empty to use the default backend/data/rag/zhishitupu.db
RAG_DATABASE_PATH=
